{
  "name": "budgedora",
  "version": "1.4.0",
  "description": "Super simple multi-account expense tracker with buckets, smart questions and reports.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node server.ts",
    "seed": "node scripts/seed-demo.ts",
    "test": "node --test \"test/*.test.ts\"",
    "test:e2e": "playwright test",
    "check": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "cf:dev": "wrangler dev",
    "cf:db:init": "wrangler d1 execute budgedora --remote --file=src/schema.sql",
    "deploy": "wrangler deploy",
    "api:types": "npx -y openapi-typescript@7.13.0 public/openapi.json -o src/api-types.ts",
    "api:check": "npm run api:types && git diff --exit-code -- src/api-types.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261124.2",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "typescript": "^7.0.2"
  }
}
