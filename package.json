{
  "name": "budgedora",
  "version": "1.2.0",
  "description": "Super simple multi-account expense tracker with buckets, smart questions and reports.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server.js",
    "seed": "node scripts/seed-demo.js",
    "cf:dev": "wrangler dev",
    "cf:db:init": "wrangler d1 execute budgedora --remote --file=src/schema.sql",
    "deploy": "wrangler deploy"
  },
  "license": "MIT"
}
