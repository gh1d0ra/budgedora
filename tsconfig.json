{
  // Type checking only (`npm run check`). Nothing is compiled: Node 22.18+ runs the .ts files
  // directly by stripping types, and wrangler bundles src/worker.ts for Cloudflare.
  // This config covers the Node side; tsconfig.worker.json covers the Worker.
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true
  },
  "include": ["server.ts", "src/api.ts", "src/sqlite-db.ts", "src/demo.ts", "src/api-types.ts", "scripts/*.ts", "test/*.ts", "e2e/*.ts", "playwright.config.ts"]
}
